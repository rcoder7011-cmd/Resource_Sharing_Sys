# ====================================================================
# Resource Sharing Platform — Backend Environment Configuration Example
# Copy this file to `server/.env` for local development.
# In production (Render, Fly.io, Railway), configure these via the dashboard.
# NEVER commit real credentials, passwords, or secrets to Git.
# ====================================================================

# Node Environment ('development', 'production', 'test')
NODE_ENV=development

# Server Listening Port (Render assigns this dynamically via $PORT)
PORT=5000

# Allowed Client Origin(s) for CORS and Socket.IO (comma-separated for multiple origins)
# Example: http://localhost:5173,https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/ResourceSharingDb?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ResourceSharingDb?retryWrites=true&w=majority

# Cryptographically Secure JWT Secret Key (minimum 32 characters in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# JWT Token Expiration Window (e.g., 1d, 7d, 24h)
JWT_EXPIRES_IN=1d

# Optional Initial Administrator Credentials (used only by `npm run seed:admin`)
ADMIN_EMAIL=admin@institution.edu
ADMIN_PASSWORD=SecureAdminPassword123!
ADMIN_NAME=Platform Administrator

# Optional DNS configuration for Windows c-ares SRV lookup workaround
# Set to 'false' in cloud production containers to use container host DNS
ENABLE_CUSTOM_DNS=false
CUSTOM_DNS_SERVERS=8.8.8.8,1.1.1.1

# Optional persistent storage directory for handover/return evidence photos
# On Render with Persistent Disk, set to: /data/uploads/evidence
# Defaults to server/uploads/evidence if omitted
# EVIDENCE_UPLOAD_DIR=/data/uploads/evidence
