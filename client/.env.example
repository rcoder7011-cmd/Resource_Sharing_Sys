# ====================================================================
# Resource Sharing Platform — Frontend Environment Configuration Example
# Copy this file to `client/.env` for local development.
# In production (Vercel), configure these via the project dashboard.
# Variables prefixed with VITE_ are embedded into public JavaScript bundles.
# NEVER place private credentials, database URIs, or secrets here.
# ====================================================================

# Backend REST API Base URL (must point to backend /api endpoint)
# Local: http://localhost:5000/api
# Production: https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# WebSocket Server URL for Socket.IO (must point to backend host root without /api)
# Local: http://localhost:5000
# Production: https://your-backend.onrender.com
VITE_SOCKET_URL=http://localhost:5000

